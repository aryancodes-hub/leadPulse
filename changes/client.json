// DashboardView.jsx
{
  "totalConversion": "number | string [optional - aggregate verified client conversions]",
  "totalCost": "number | string [optional - cumulative campaign spend in dollars]",
  "conversionRate": "number | string [optional - percentage rate, e.g., 15.4 or '15.4%']",
  "totalCalls": "number [optional - total calls placed across all sequences]",
  "totalEmails": "number [optional - total emails sent across all campaigns]",
  "activeCampaigns": "number [optional - count of currently running campaigns]",
  "completedCampaigns": "number [optional - count of finished campaigns]",
  "totalCampaigns": "number [optional - total registered campaigns]"
}

